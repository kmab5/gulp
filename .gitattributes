# Consistent line endings on Windows/macOS/Linux. No renormalization needed to apply this update.
* text=auto
*.kt text eol=lf
*.kts text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.bat text eol=crlf
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.zip binary
